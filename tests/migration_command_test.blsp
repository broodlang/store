;; `migration/command` — the commands that need no database: check and gen read the migrations
;; as data, and a bad command or flag is refused before any database is opened.
(defmodule migration-command-test
  (:use test)
  (:alias migration))

(def- migrations
  [{:version 20260101000000
    :name "users"
    :up [[:create-table :users {:primary-key :id :fields {:id :serial :email :text}}]]}])

(def- users {:table :users :primary-key :id :fields {:id :serial :email :text}})

(def- users-with-handle (assoc users :fields (assoc (get users :fields) :handle :text)))

(describe "migration/command"
  (test "check is 0 when the migrations build the schemas"
    (assert= (migration/command nil {} migrations [users] ["check"]) 0))
  (test "check is 1 when a schema moved without a migration"
    (assert= (migration/command nil {} migrations [users-with-handle] ["check"]) 1))
  (test "gen prints the migration and succeeds"
    (assert= (migration/command nil {} migrations [users-with-handle] ["gen" "users-handle"]) 0))
  (test "gen without a name, or an unknown command, is the usage and 1"
    (assert= (migration/command nil {} migrations [users] ["gen"]) 1)
    (assert= (migration/command nil {} migrations [users] ["frobnicate"]) 1))
  ;; A deploy's release command shows only what the process prints: a failure is one line
  ;; and exit 1, not an exception out of `main`.
  (test "a command that fails is 1, not a raise"
    (assert= (migration/command nil {} (conj migrations (first migrations)) [users] ["check"]) 1))
  ;; Refused before any database is opened (the adaptor here is nil): `down --to` with its
  ;; version missing must not become a plain `down`, which rolls back the newest migration.
  (test "a --to or --step without a whole number is refused"
    (assert= (migration/command nil {} migrations [users] ["down" "--to"]) 1)
    (assert= (migration/command nil {} migrations [users] ["down" "--step" "two"]) 1)
    (assert= (migration/command nil {} migrations [users] ["up" "--to" "1.5"]) 1)))

(describe "migration/command setup"
  ;; Refused before any database is touched: an adaptor that cannot create one says so.
  (test "setup with an adaptor that has no :create-database is 1"
    (assert= (migration/command {} {} migrations [users] ["setup"]) 1)))

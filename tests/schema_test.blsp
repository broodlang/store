;; Schema-as-data → DDL. No database.
(defmodule schema-test
  (:use test)
  (:alias schema))

(describe "schema: tables"
  (test "create-table-sql renders DDL with a primary key"
    (is (= (schema/create-table-sql {:table :users :fields {:id :integer} :primary-key :id})
          "CREATE TABLE \"users\" (\"id\" integer, PRIMARY KEY (\"id\"))")))
  (test "if-not-exists, and a composite primary key"
    (is (= (schema/create-table-sql {:table :t :fields {:a :text} :primary-key [:a :b]}
             {:if-not-exists true})
          "CREATE TABLE IF NOT EXISTS \"t\" (\"a\" text, PRIMARY KEY (\"a\", \"b\"))")))
  (test "abstract type vocabulary maps to SQL"
    (is (= (schema/column-type :integer) "integer"))
    (is (= (schema/column-type :text) "text"))
    (is (= (schema/column-type :decimal) "numeric"))
    (is (= (schema/column-type :boolean) "boolean"))
    (is (= (schema/column-type :binary) "bytea"))
    (is (= (schema/column-type :uuid) "uuid")))
  (test "drop-table-sql"
    (is (= (schema/drop-table-sql {:table :users}) "DROP TABLE \"users\""))
    (is (= (schema/drop-table-sql :users {:if-exists true :cascade true})
          "DROP TABLE IF EXISTS \"users\" CASCADE"))))

(describe "schema: columns"
  (test "a field spec in short and long form"
    (is (= (schema/field-spec :text) {:type :text}))
    (is (= (schema/field-spec [:text {:null false}]) {:type :text :null false}))
    (is (= (schema/field-spec {:type :text}) {:type :text})))
  (test "NOT NULL, DEFAULT and REFERENCES"
    (is (= (schema/column-sql :role [:text {:null false :default "it's"}])
          "\"role\" text NOT NULL DEFAULT 'it''s'"))
    (is (= (schema/column-sql :org [:integer {:references {:table :orgs :on-delete :cascade}}])
          "\"org\" integer REFERENCES \"orgs\" (\"id\") ON DELETE CASCADE"))
    (is (= (schema/column-sql :at [:bigint {:default [:raw "0"]}]) "\"at\" bigint DEFAULT 0")))
  (test "add / drop / rename / alter"
    (is (= (schema/add-column-sql :users :handle :text {:if-not-exists true})
          "ALTER TABLE \"users\" ADD COLUMN IF NOT EXISTS \"handle\" text"))
    (is (= (schema/drop-column-sql :users :handle) "ALTER TABLE \"users\" DROP COLUMN \"handle\""))
    (is (= (schema/rename-column-sql :users :a :b)
          "ALTER TABLE \"users\" RENAME COLUMN \"a\" TO \"b\""))
    (is (= (schema/alter-column-sql :users :n {:type :bigint :null false :default nil})
          (str "ALTER TABLE \"users\" ALTER COLUMN \"n\" TYPE bigint, ALTER COLUMN \"n\" SET NOT NULL, "
            "ALTER COLUMN \"n\" DROP DEFAULT"))))
  (test "an alter that changes nothing is an error"
    (assert-error (schema/alter-column-sql :users :n {}))))

(describe "schema: indexes"
  (test "default name, unique, partial with an inlined literal"
    (is (= (schema/create-index-sql :users {:columns [:email] :unique true})
          "CREATE UNIQUE INDEX \"users_email_index\" ON \"users\" (\"email\")"))
    (is (= (schema/create-index-sql :p
             {:columns [:project_id :operation_id]
              :name "p_changes"
              :where [:like :name "change/%"]}
             {:concurrently true :if-not-exists true})
          (str "CREATE INDEX CONCURRENTLY IF NOT EXISTS \"p_changes\" ON \"p\" (\"project_id\", \"operation_id\") "
            "WHERE \"name\" LIKE 'change/%'"))))
  (test "drop-index-sql"
    (is (= (schema/drop-index-sql "users_email_index" {:if-exists true})
          "DROP INDEX IF EXISTS \"users_email_index\"")))
  (test "indexes fills in each name"
    (is (= (map (schema/indexes {:table :t :indexes [{:columns [:a]} {:columns [:b] :name "x"}]})
             (fn (i) (get i :name)))
          (list "t_a_index" "x")))))

(describe "schema: constraints"
  (test "a unique and a check constraint, named the way Postgres names them"
    (is (= (schema/create-table-sql {:table :orgs
                                     :primary-key :id
                                     :fields {:id :serial}
                                     :constraints [{:unique [:name]}
                                                    {:check [:<> [:is-nil :name] [:is-nil :user_id]]}]})
          (str "CREATE TABLE \"orgs\" (\"id\" serial, PRIMARY KEY (\"id\"), "
            "CONSTRAINT \"orgs_name_key\" UNIQUE (\"name\"), "
            "CONSTRAINT \"orgs_check\" CHECK ((\"name\" IS NULL) <> (\"user_id\" IS NULL)))"))))
  (test "a predicate inside another expression is parenthesised"
    (is (= (schema/inline-expr [:= [:not [:= :a 1]] [:like :b "x%"]])
          "(NOT (\"a\" = 1)) = (\"b\" LIKE 'x%')"))
    (is (= (schema/inline-expr [:and [:not-nil :a] [:like :name "change/%"]])
          "(\"a\" IS NOT NULL AND \"name\" LIKE 'change/%')")))
  (test "a check's values are inlined, and a name can be given"
    (is (= (schema/constraint-sql :t {:name "t_role" :check [:in :role ["a" "b"]]})
          "CONSTRAINT \"t_role\" CHECK (\"role\" IN ('a', 'b'))")))
  (test "add and drop"
    (is (= (schema/add-constraint-sql :t {:unique [:a :b]})
          "ALTER TABLE \"t\" ADD CONSTRAINT \"t_a_b_key\" UNIQUE (\"a\", \"b\")"))
    (is (= (schema/drop-constraint-sql :t "t_a_b_key" {:if-exists true})
          "ALTER TABLE \"t\" DROP CONSTRAINT IF EXISTS \"t_a_b_key\"")))
  (test "a constraint that is neither is an error"
    (assert-error (schema/constraint-spec :t {:name "x"}))))

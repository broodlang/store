;; Schema-as-data → DDL. No database.
(defmodule schema-test
  (:use test)
  (:use schema))

(describe "schema"
  (test "create-table-sql renders DDL with a primary key"
    (is (= (create-table-sql {:table :users :fields {:id :integer} :primary-key :id})
          "CREATE TABLE users (id integer, PRIMARY KEY (id))")))
  (test "abstract type vocabulary maps to portable SQL"
    (is (= (column-type :integer) "integer"))
    (is (= (column-type :text) "text"))
    (is (= (column-type :decimal) "numeric"))
    (is (= (column-type :boolean) "boolean"))
    (is (= (column-type :uuid) "uuid"))) ; unknown type → emitted verbatim
  (test "drop-table-sql"
    (is (= (drop-table-sql {:table :users}) "DROP TABLE IF EXISTS users"))))

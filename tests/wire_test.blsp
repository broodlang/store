;; Wire-layer tests: byte codecs, raw-byte HMAC/base64, and the SCRAM-SHA-256 flow
;; checked against the RFC 7677 §3 worked example. No database needed.
(defmodule wire-test
  (:use test)
  (:use hash)
  (:use wire/bytes)
  (:use wire/scram))

(describe "bytes: integers + cstrings round-trip"
  (test "int32 big-endian round-trips"
    (is (= (read-int32 (int32-be 196608) 0) 196608))
    (is (= (read-int32 (int32-be 4096) 0) 4096)))
  (test "int16 big-endian round-trips"
    (is (= (read-int16 (int16-be 65535) 0) 65535))
    (is (= (read-int16 (int16-be 1) 0) 1)))
  (test "cstring writes a NUL terminator and reads back"
    (let (s (cstring "user"))
      (is (= (string-length s) 5))
      (is (= (read-cstring s 0) ["user" 5])))))

(describe "bytes: base64 over raw bytes"
  (test "encodes with correct padding"
    (is (= (b64-encode [102 111 111]) "Zm9v"))      ; "foo"
    (is (= (b64-encode [102 111]) "Zm8="))          ; "fo"
    (is (= (b64-encode [102]) "Zg==")))             ; "f"
  (test "decode is the inverse of encode"
    (is (= (b64-decode (b64-encode [0 1 2 250 251 255])) [0 1 2 250 251 255]))))

(describe "bytes: HMAC-SHA-256 over raw bytes"
  (test "matches the string builtin for ASCII inputs"
    (let (mine (hmac256 (into [] (string->utf8-bytes "key"))
                 (into [] (string->utf8-bytes "msg"))))
      ;; bytes->hex inline
      (is (= (apply str (map (fn (b)
                               (str (char-at "0123456789abcdef" (quot b 16))
                                 (char-at "0123456789abcdef" (rem b 16))))
                          mine))
            (hmac-sha256 "key" "msg"))))))

(describe "scram: RFC 7677 worked example"
  ;; user "user" / password "pencil" with the RFC's fixed nonce.
  (def *client-nonce* "rOprNGfwEbeRWgbNEkqO")
  (def *server-first*
    "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096")
  (def *server-final* "v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=")

  (test "client-first is the gs2 header + bare message"
    (let (st (start "user" "pencil" *client-nonce*))
      (is (= (get st :first) "n,,n=user,r=rOprNGfwEbeRWgbNEkqO"))))

  (test "client-final carries the expected proof"
    (let (st (continue (start "user" "pencil" *client-nonce*) *server-first*))
      (is (= (get st :final)
            (str "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0"
              ",p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=")))))

  (test "server signature verifies"
    (let (st (continue (start "user" "pencil" *client-nonce*) *server-first*))
      (is (= (finish st *server-final*) :ok))))

  (test "a tampered server signature is rejected"
    (let (st (continue (start "user" "pencil" *client-nonce*) *server-first*))
      (is (= (first (finish st "v=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="))
            :error)))))

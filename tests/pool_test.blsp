;; Live pool/connection tests. Requires a reachable Postgres (PG* env vars, default
;; postgres/postgres @ 127.0.0.1:5432). Each test runs in its own process, so the
;; spawn/send/receive request-reply works (unlike the bare top-level).
(defmodule pool-test
  (:use test)
  (:alias connection)
  (:alias pool))

(defn opts ()
  {:host (or (getenv "PGHOST") "127.0.0.1")
   :port (string->number (or (getenv "PGPORT") "5432"))
   :user (or (getenv "PGUSER") "postgres")
   :password (or (getenv "PGPASSWORD") "postgres")
   :database (or (getenv "PGDATABASE") "postgres")})

(defn one-int (result)
  "First column of the first row of a result map."
  (get (first (get result :rows)) 0))

(describe "connection process"
  :isolated
  (test "serves a simple query"
    (let (pid (connection/start (opts))
          res (connection/query pid "select 42 as answer"))
      (is (= (get res 0) :ok))
      (is (= (one-int (get res 1)) 42))
      (connection/stop pid)))
  (test "serves a parameterized query"
    (let (pid (connection/start (opts))
          res (connection/exec pid "select $1::int * 2 as doubled" [21]))
      (is (= (get res 0) :ok))
      (is (= (one-int (get res 1)) 42))
      (connection/stop pid)))
  (test "a query error is recoverable — the connection keeps serving"
    (let (pid (connection/start (opts))
          bad (connection/query pid "select * from no_such_table"))
      (is (= (get bad 0) :error))
      ;; same connection still works afterward
      (is (= (one-int (get (connection/query pid "select 7") 1)) 7))
      (connection/stop pid))))

(describe "pool"
  :isolated
  (test "sequential query and exec"
    (let (p (pool/start (assoc (opts) :size 2)))
      (is (= (one-int (pool/query p "select 1 as x")) 1))
      (is (= (one-int (pool/exec p "select $1::int as x" [99])) 99))
      (pool/stop p)))
  (test "more concurrent jobs than connections all complete"
    (let (p (pool/start (assoc (opts) :size 2))
          parent (self))
      (map (fn (i)
             (spawn
               (send parent [:r (one-int (pool/query p (str "select " i " as n")))])))
        (range 6))
      (let (results (into [] (map (fn (_)
                                    (receive ([:r v] v) (after 30000 :timeout)))
                               (range 6))))
        (is (= (count results) 6))
        (is (not (includes? results :timeout))))
      (pool/stop p)))
  (test "a killed connection is respawned and the pool keeps serving"
    (let (p (pool/start (assoc (opts) :size 2))
          victim (pool/checkout p))
      (exit victim :killed)
      (pool/checkin p victim)      ; dead pid — pool ignores it
      ;; the pool still serves (other conn + respawn)
      (is (= (one-int (pool/query p "select 5")) 5))
      (is (= (one-int (pool/query p "select 6")) 6))
      (pool/stop p))))

(defmodule wire/bytes
  "Byte-level toolkit for the Postgres wire protocol.

  Brood strings are codepoint sequences; a socket in binary mode (`tcp-set-binary`)
  carries one codepoint 0–255 per wire byte (the Latin-1 carrier). So we represent
  wire data two ways and convert at the seams:

    - a *byte string*  — codepoints 0–255, what `tcp-send` writes and `[:tcp …]`
                         delivers (same convention as http/websocket);
    - a *byte vector*  — a vector of ints 0–255, what `crypto`/`hash` operate on.

  Crypto/encoding now live in the stdlib's raw-byte layer (`hash/*-raw`,
  `crypto/pbkdf2` over byte vectors, `encoding/base64-*-bytes` / `hex-*-bytes`);
  this module is just the wire-format glue — the carrier, fixed-width ints, and
  CStrings."
  (:use encoding))

;; ---- byte <-> codepoint -----------------------------------------------------

;; Position n holds the 1-char string for byte value n (all 256). \xHH is one byte.
(def *byte-table*
  (str "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f"
    "\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f"
    "\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f"
    "\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f"
    "\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f"
    "\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f"
    "\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f"
    "\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f"
    "\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f"
    "\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f"
    "\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf"
    "\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf"
    "\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf"
    "\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf"
    "\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef"
    "\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"))

(defn byte->char (n)
  "Byte value 0–255 → its 1-char byte string."
  (char-at *byte-table* n))

(defn byte-at (s i)
  "Byte value at index `i` of byte string `s`."
  (char->int (char-at s i)))

(defn bytes->bytestr (bv)
  "Byte vector → byte string (one codepoint per byte). For `tcp-send`."
  (apply str (map byte->char bv)))

(defn bytestr->bytes (s)
  "Byte string → byte vector of ints 0–255. For `crypto`/`hash`."
  (into [] (map (fn (i) (byte-at s i)) (range (string-length s)))))

(defn utf8-bytestr (s)
  "UTF-8-encode text `s` into a byte string (one codepoint 0–255 per UTF-8 byte)."
  (apply str (map byte->char (string->utf8-bytes s))))

(defn bytestr->utf8 (s)
  "Decode a byte string holding UTF-8 back into text."
  (utf8-bytes->string (bytestr->bytes s)))

(defn bytes->carrier (b)
  "Convert a `bytes` value (what binary-mode `[:tcp …]` now delivers) to this
  module's Latin-1 byte-string carrier, so the existing string-based frame reader
  keeps working. (A full bytes-native rewrite of the wire codec is a clean
  follow-up; this keeps the driver working on the migrated runtime.)"
  (apply str (map byte->char (bytes->list b))))

;; ---- fixed-width big-endian integers ----------------------------------------

(defn int32-be (n)
  "Non-negative `n` → 4-byte big-endian byte string (Postgres Int32)."
  (str (byte->char (bit-and (bit-shift-right n 24) 255))
    (byte->char (bit-and (bit-shift-right n 16) 255))
    (byte->char (bit-and (bit-shift-right n 8) 255))
    (byte->char (bit-and n 255))))

(defn int16-be (n)
  "Non-negative `n` → 2-byte big-endian byte string (Postgres Int16)."
  (str (byte->char (bit-and (bit-shift-right n 8) 255))
    (byte->char (bit-and n 255))))

(defn read-int32 (s off)
  "Read an unsigned 32-bit big-endian int at byte offset `off` of byte string `s`."
  (+ (* (byte-at s off) 16777216)
    (* (byte-at s (+ off 1)) 65536)
    (* (byte-at s (+ off 2)) 256)
    (byte-at s (+ off 3))))

(defn read-int16 (s off)
  "Read an unsigned 16-bit big-endian int at byte offset `off` of byte string `s`."
  (+ (* (byte-at s off) 256) (byte-at s (+ off 1))))

;; ---- C strings (NUL-terminated) ---------------------------------------------

(defn cstring (text)
  "Text → a NUL-terminated byte string (Postgres CString)."
  (str (utf8-bytestr text) "\x00"))

(defn read-cstring (s off)
  "Read a NUL-terminated string starting at `off`. Returns `[text next-off]` where
  `next-off` is just past the NUL."
  (read-cstring--scan s off off))

(defn read-cstring--scan (s start i)
  (if (= (byte-at s i) 0)
    [(bytestr->utf8 (substring s start i)) (+ i 1)]
    (read-cstring--scan s start (+ i 1))))

;; ---- byte-vector XOR (SCRAM's client proof; no stdlib equivalent) -----------

(defn xor-bytes (a b)
  "XOR two equal-length byte vectors → byte vector."
  (into [] (map (fn (i) (bit-xor (get a i) (get b i))) (range (count a)))))

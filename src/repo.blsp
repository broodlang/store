(defmodule repo
  "The repo — the boundary between your code and the database.

  Open it with an *adaptor* (a contract map, e.g. from `store-postgres`'s `pg/adaptor`)
  and connection opts; run data queries through it. The adaptor performs the SQL I/O,
  so this library stays database-agnostic. `all`/`one` take a query map (see `query`)
  and return rows as plain maps keyed by column name."
  (:alias query)
  (:alias schema))

(defn open (adaptor opts)
  "Open a repo over `adaptor` and connection `opts` (starts the adaptor's pool).
  Returns a repo handle; close it with `close`."
  {:adaptor adaptor :pool ((get adaptor :start-pool) opts)})

(defn close (repo)
  "Stop the repo's connection pool."
  ((get (get repo :adaptor) :stop-pool) (get repo :pool)))

;; ---- running queries --------------------------------------------------------

(defn exec (repo sql params)
  "Run raw parameterized SQL (`$1`, `$2`, …) — the escape hatch. Returns the rows
  as maps keyed by column name (keywords); the adaptor handles the DB specifics."
  ((get (get repo :adaptor) :exec) (get repo :pool) sql params))

(defn all (repo q)
  "Run query `q` and return its rows as maps keyed by column name (keywords)."
  (let (sp (query/to-sql q))
    (exec repo (get sp 0) (get sp 1))))

(defn one (repo q)
  "Run `q` with LIMIT 1; return the first row map, or nil if none."
  (first (all repo (query/limit q 1))))

;; ---- writes -----------------------------------------------------------------

(defn insert (repo table row)
  "Insert one `{:col value …}` row into `table`; return the inserted row map."
  (let (sp (query/insert-sql table row))
    (first (exec repo (get sp 0) (get sp 1)))))

(defn update (repo table changes where-expr)
  "Set `changes` on rows of `table` matching `where-expr`; return the updated rows."
  (let (sp (query/update-sql table changes where-expr))
    (exec repo (get sp 0) (get sp 1))))

(defn delete (repo table where-expr)
  "Delete rows of `table` matching `where-expr`; return the deleted rows."
  (let (sp (query/delete-sql table where-expr))
    (exec repo (get sp 0) (get sp 1))))

;; ---- migrations (derived from a schema) -------------------------------------

(defn create-table (repo schema-map)
  "Create the table described by `schema-map` (see the `schema` module)."
  (exec repo (schema/create-table-sql schema-map) []))

(defn drop-table (repo schema-map)
  "Drop the table described by `schema-map` (IF EXISTS)."
  (exec repo (schema/drop-table-sql schema-map) []))

;; ---- migration diffing (reconcile a live table with a schema) ----------------

(defn columns (repo table)
  "The live column names (keywords) of `table`, via the adaptor's introspection.
  Empty when the table doesn't exist."
  (map (fn (c) (keyword (get c :name)))
    ((get (get repo :adaptor) :columns) (get repo :pool) (name (if (map? table) (get table :table) table)))))

(defn diff (repo schema-map)
  "Compare `schema-map`'s :fields to the live table; return the migration as data:
  `{:create true}` if the table is absent, else `{:add [field…] :drop [col…]}`
  (fields to ADD, live columns to DROP — both possibly empty)."
  (let (have (columns repo schema-map))
    (if (empty? have)
      {:create true}
      (let (want (keys (get schema-map :fields))
            have-set (reduce (fn (m c) (assoc m c true)) {} have)
            want-set (reduce (fn (m c) (assoc m c true)) {} want))
        {:add (into [] (filter (fn (f) (nil? (get have-set f))) want))
         :drop (into [] (filter (fn (c) (nil? (get want-set c))) have))}))))

(defn migrate (repo schema-map & opts)
  "Reconcile the live table with `schema-map`. Creates it if absent; otherwise ADDs
  any new fields. Pass `{:drop true}` to also DROP columns no longer in the schema
  (off by default — it loses data). Returns the SQL statements run."
  (let (o (if (empty? opts) {} (first opts))
        d (diff repo schema-map)
        table (get schema-map :table)
        fields (get schema-map :fields))
    (if (get d :create)
      (do (create-table repo schema-map) [(schema/create-table-sql schema-map)])
      (let (adds (map (fn (f) (schema/add-column-sql table f (get fields f))) (get d :add))
            drops (if (get o :drop)
                    (map (fn (c) (schema/drop-column-sql table c)) (get d :drop))
                    [])
            stmts (append adds drops))
        (reduce (fn (_ s) (exec repo s [])) nil stmts)
        stmts))))

;; ---- associations / preloads ------------------------------------------------
;; A schema's :associations describes related tables, e.g.
;;   :associations
;;     {:posts  {:type :has-many   :table :posts :fk :author_id :schema (fn () post)}
;;      :author {:type :belongs-to :table :users :fk :author_id :references :id}
;;      :tags   {:type :many-to-many :table :tags :join-table :post_tags
;;               :join-keys [:post_id :tag_id] :references :id :schema (fn () tag)}}
;; preload runs ONE query per association level (no N+1; many-to-many is two — the
;; join table then the targets). `:schema` (the related schema, or a thunk for
;; mutually-recursive schemas) is only needed for NESTED preloads.

(defn preload (repo schema rows spec)
  "Eager-load associations onto `rows`. `spec` is a keyword (one association), a
  vector of specs `[:posts :author]`, or a map `{assoc → nested-spec}` for nested
  preloads, e.g. `{:posts :comments}` or `{:posts [:comments :author]}`."
  (cond
    (keyword? spec) (preload--one repo schema rows spec nil)
    (map? spec) (reduce (fn (rs k) (preload--one repo schema rs k (get spec k))) rows (keys spec))
    (vector? spec) (reduce (fn (rs s) (preload repo schema rs s)) rows spec)
    else (throw (str "preload: bad spec " (pr-str spec)))))

(defn preload--one (repo schema rows akey nested)
  (let (rel (get (get schema :associations) akey))
    (if (nil? rel)
      (throw (str "preload: schema has no association " (pr-str akey)))
      (let (loaded (preload--attach repo schema rows akey rel))
        (if (nil? nested) loaded (preload--nest repo loaded akey rel nested))))))

(defn preload--attach (repo schema rows akey rel)
  "Run one association's query and attach it under `akey` (no nesting)."
  (cond
    (= (get rel :type) :has-many) (preload--children repo rows akey rel (get schema :primary-key) false)
    (= (get rel :type) :has-one) (preload--children repo rows akey rel (get schema :primary-key) true)
    (= (get rel :type) :belongs-to) (preload--belongs-to repo rows akey rel)
    (= (get rel :type) :many-to-many) (preload--many-to-many repo rows akey rel (get schema :primary-key))
    else (throw (str "preload: unknown association type " (pr-str (get rel :type))))))

;; has-many / has-one: child.fk references the parent's key. `one?` attaches the
;; first child instead of the list.
(defn preload--children (repo rows akey rel parent-key one?)
  (let (ref (or (get rel :references) parent-key)
        fk (get rel :fk)
        ids (distinct (filter (fn (x) (not (nil? x))) (map (fn (r) (get r ref)) rows)))
        kids (if (empty? ids)
               []
               (all repo (-> (query/from (get rel :table)) (query/where [:in fk ids]))))
        grouped (group-by (fn (c) (get c fk)) kids))
    (map (fn (r)
           (let (g (or (get grouped (get r ref)) []))
             (assoc r akey (if one? (first g) g))))
      rows)))

;; belongs-to: this row's fk references the target's key; attach the single match.
(defn preload--belongs-to (repo rows akey rel)
  (let (fk (get rel :fk)
        ref (or (get rel :references) :id)
        ids (distinct (filter (fn (x) (not (nil? x))) (map (fn (r) (get r fk)) rows)))
        parents (if (empty? ids)
                  []
                  (all repo (-> (query/from (get rel :table)) (query/where [:in ref ids]))))
        index (reduce (fn (m p) (assoc m (get p ref) p)) {} parents))
    (map (fn (r) (assoc r akey (get index (get r fk)))) rows)))

;; many-to-many: parent → join-table → target. Two queries: the join rows for the
;; parents' keys, then the targets for the join's target keys.
(defn preload--many-to-many (repo rows akey rel parent-key)
  (let (jk (get rel :join-keys)
        pfk (first jk) tfk (second jk)
        tref (or (get rel :references) :id)
        pkeys (distinct (filter (fn (x) (not (nil? x))) (map (fn (r) (get r parent-key)) rows)))
        joins (if (empty? pkeys)
                []
                (all repo (-> (query/from (get rel :join-table)) (query/where [:in pfk pkeys]))))
        tids (distinct (filter (fn (x) (not (nil? x))) (map (fn (j) (get j tfk)) joins)))
        targets (if (empty? tids)
                  []
                  (all repo (-> (query/from (get rel :table)) (query/where [:in tref tids]))))
        tindex (reduce (fn (m t) (assoc m (get t tref) t)) {} targets)
        joins-by-parent (group-by (fn (j) (get j pfk)) joins))
    (map (fn (r)
           (let (js (or (get joins-by-parent (get r parent-key)) []))
             (assoc r akey (map (fn (j) (get tindex (get j tfk))) js))))
      rows)))

;; Nested preload: recurse `nested` onto the just-loaded associated rows, using the
;; association's `:schema`, then re-attach by primary key (collect → preload → index
;; → redistribute, so it stays one query per level).
(defn preload--nest (repo loaded akey rel nested)
  (let (child-schema (resolve-schema (get rel :schema) akey)
        child-pk (get child-schema :primary-key)
        many? (not (= (get rel :type) :belongs-to))
        kids (if many?
               (reduce (fn (acc r) (into acc (get r akey))) [] loaded)
               (filter (fn (x) (not (nil? x))) (map (fn (r) (get r akey)) loaded)))
        done (preload repo child-schema kids nested)
        idx (reduce (fn (m c) (assoc m (get c child-pk) c)) {} done))
    (map (fn (r)
           (assoc r akey
             (if many?
               (map (fn (c) (get idx (get c child-pk))) (get r akey))
               (let (c (get r akey)) (if (nil? c) nil (get idx (get c child-pk)))))))
      loaded)))

(defn resolve-schema (s akey)
  (cond
    (nil? s) (throw (str "preload: association " (pr-str akey)
                      " needs a :schema for a nested preload"))
    (fn? s) (s)
    else s))

;; ---- transactions -----------------------------------------------------------

(defn transaction (repo f)
  "Run `(f tx)` inside a database transaction. `tx` is a repo bound to the
  transaction's single connection — use the same `all`/`one`/`insert`/`update`/
  `delete`/`exec` on it. Commits if `f` returns; rolls back and re-raises if `f`
  throws. Returns `f`'s value. (Adaptor-dependent: store-postgres is fully
  transactional; an adaptor that can't support it raises.)"
  ((get (get repo :adaptor) :transaction)
   (get repo :pool)
   (fn (tx-exec)
     (f {:adaptor {:exec (fn (_ sql params) (tx-exec sql params))}
         :pool nil}))))

(defmodule repo
  "The repo — the boundary between your code and the database.

  Open it with an *adaptor* (a contract map, e.g. from `store-postgres`'s `pg/adaptor`)
  and connection opts; run data queries through it. The adaptor performs the SQL I/O,
  so this library stays database-agnostic. `all`/`one` take a query map (see `query`)
  and return rows as plain maps keyed by column name.

  A repo is either **pooled** (what `open` returns — each statement borrows any
  connection) or **bound** to one connection (what `with-connection` and `transaction`
  hand their function). Every function here takes either, so code written against a repo
  runs unchanged inside a transaction.

  The adaptor contract:

    :start-pool      (opts) -> pool
    :stop-pool       (pool) -> any
    :exec            (pool sql params) -> rows
    :with-connection (pool f) -> (f run), `run` being (sql params) -> rows on ONE connection
    :columns         (pool table) -> [{:name :type}…]           ; optional, introspection
    :lock-sql        {:acquire sql :release sql :transaction sql} ; optional, advisory locks

  A failed statement raises the adaptor's error map. A constraint violation carries
  `:violation` (`:unique` `:foreign-key` `:check` `:not-null` `:exclusion`) and
  `:constraint` (its name), which is what `insert-changeset` maps to a field error."
  (:alias query)
  (:alias telemetry)
  (:alias seq)
  (:alias string)
  (:alias schema)
  (:alias changeset))

(defn open (adaptor opts)
  "Open a repo over `adaptor` and connection `opts` (starts the adaptor's pool).
  Returns a repo handle; close it with `close`."
  {:adaptor adaptor :pool ((get adaptor :start-pool) opts)})

(defn close (repo)
  "Stop the repo's connection pool."
  ((get (get repo :adaptor) :stop-pool) (get repo :pool)))

;; ---- running queries --------------------------------------------------------
;;
;; Every query the repo runs — `all`, `one`, the writes, migrations, a transaction's
;; statements — passes through `exec`, which makes it the one place to say that a query
;; happened. It emits `[:store :query :stop]` (measurements `{:duration ms}`, metadata
;; `{:sql :op :source :params :rows}`) after each one and `[:store :query :exception]`
;; (`{:sql :op :source :params :error}`) when the adaptor raised, the way Ecto's repo
;; emits `[:repo :query]`: a fire-and-forget send, nothing when telemetry is not started,
;; and never a change to what the caller gets back. `:op` and `:source` are read off the
;; SQL so a metric can be keyed on a bounded pair (`SELECT packages`) instead of the
;; statement; `:params` is a count, the values are the data.

(def- shape-keywords ["FROM" "INTO" "UPDATE" "TABLE" "JOIN"])

;; `CREATE TABLE IF NOT EXISTS t`, `DROP TABLE IF EXISTS t`, `UPDATE ONLY t`
(def- shape-qualifiers ["IF" "NOT" "EXISTS" "ONLY"])

(defn- shape-name (ws)
  "The first word of `ws` that is not a qualifier, with a trailing column list or `;`
  stripped and its identifier quotes removed — `INSERT INTO \"t\" (a, b)` / `FROM t;` —
  or nil."
  (cond
    (empty? ws) nil
    (includes? shape-qualifiers (string/upper (first ws))) (shape-name (rest ws))
    :else
      (let (name (string/replace (first (string/split (first (string/split (first ws) "(")) ";"))
                   "\"" ""))
        (if (= name "") nil name))))

(defn statement-shape (sql)
  "The statement kind and the table it names, from the SQL: `{:op \"SELECT\" :source
  \"packages\"}`. The op is the first word, upper-cased; the source is the word after
  `FROM`, `INTO`, `UPDATE`, `TABLE` or `JOIN` — whichever comes first, skipping `IF NOT
  EXISTS` and the like — or nil when the statement names none (`SELECT 1`)."
  (let (words (seq/filter (string/split (string/trim sql) " ") (fn (w) (not (= w ""))))
        op (string/upper (or (first words) ""))
        source (letrec (after (fn (ws)
                                (cond
                                  (empty? ws) nil
                                  (includes? shape-keywords (string/upper (first ws)))
                                    (shape-name (rest ws))
                                  :else (after (rest ws)))))
                 (after words)))
    {:op op :source source}))

(defn- query-metadata (sql params)
  (assoc (statement-shape sql) :sql sql :params (count params)))

(defn- elapsed-ms (started-ns)
  (/ (- (os/now-ns) started-ns) 1000000.0))

(defn- run-statement (repo sql params)
  (let (run (get repo :run))
    (if (nil? run)
      ((get (get repo :adaptor) :exec) (get repo :pool) sql params)
      (run sql params))))

(defn exec (repo sql params)
  "Run raw parameterized SQL (`$1`, `$2`, …) — the escape hatch. Returns the rows
  as maps keyed by column name (keywords); the adaptor handles the DB specifics.
  Emits the `[:store :query …]` telemetry events (see above)."
  (let (started (os/now-ns)
        metadata (query-metadata sql params))
    (try
      (let (rows (run-statement repo sql params))
        (telemetry/emit [:store :query :stop]
          {:duration (elapsed-ms started)}
          (assoc metadata :rows (count rows)))
        rows)
      (catch e
        (telemetry/emit [:store :query :exception]
          {:duration (elapsed-ms started)}
          (assoc metadata :error (if (map? e) (get e :message (pr-str e)) (error-message e))))
        (throw e)))))

(defn- exec-compiled (repo compiled)
  (exec repo (first compiled) (second compiled)))

(defn all (repo q)
  "Run query `q` and return its rows as maps keyed by column name (keywords)."
  (exec-compiled repo (query/to-sql q)))

(defn one (repo q)
  "Run `q` with LIMIT 1; return the first row map, or nil if none."
  (first (all repo (query/limit q 1))))

(defn- unordered (q)
  (dissoc q :order :limit :offset))

(defn aggregate (repo q op &optional column)
  "One aggregate over the rows `q` selects: `(aggregate repo q :sum :bytes)`. `op` is
  `:count` `:sum` `:max` `:min` or `:avg`; nil when no row contributes (except `:count`,
  which is 0)."
  (let (expr (if (nil? column) [op] [op column])
        row (one repo (query/select (unordered q) [[:as expr :aggregate]])))
    (get row :aggregate)))

(defn count-rows (repo q)
  "How many rows `q` selects."
  (or (aggregate repo q :count) 0))

(defn exists? (repo q)
  "True when `q` selects at least one row."
  (not (nil? (one repo (query/select (unordered q) [[:as [:raw "1"] :present]])))))

(defn ping (repo)
  "True when the database answers a trivial query; raises when it does not."
  (exec repo "SELECT 1" [])
  true)

;; ---- writes -----------------------------------------------------------------
;; Each takes an optional `opts` map: `:returning` (`:all`, the default — RETURNING * —
;; a vector of columns, or `:none`), and for an insert `:on-conflict` (see `query`).

(defn insert (repo table row &optional (opts {}))
  "Insert one `{:col value …}` row into `table`; return the row RETURNING gave back
  (nil with `:returning :none`, or when `:on-conflict` did nothing)."
  (first (exec-compiled repo (query/insert-sql table row opts))))

(defn insert-all (repo table rows &optional (opts {}))
  "Insert `rows` (each with the same columns) in one statement; return the rows given
  back. An empty `rows` is no statement at all."
  (if (empty? rows) [] (exec-compiled repo (query/insert-all-sql table rows opts))))

(defn update (repo table changes where-expr &optional (opts {}))
  "Set `changes` on rows of `table` matching `where-expr`; return the updated rows. A
  change may be an expression: `{:downloads [:+ :downloads 1]}`."
  (exec-compiled repo (query/update-sql table changes where-expr opts)))

(defn delete (repo table where-expr &optional (opts {}))
  "Delete rows of `table` matching `where-expr`; return the deleted rows."
  (exec-compiled repo (query/delete-sql table where-expr opts)))

;; ---- changesets ---------------------------------------------------------------

(defn- persist (cs action thunk)
  "Run `thunk` for a valid changeset; an invalid one, or a constraint the changeset
  declared, comes back as `[:error cs]` with its `:action` set."
  (if (not (changeset/valid? cs))
    [:error (changeset/with-action cs action)]
    (let (outcome (try [:ok (thunk)] (catch e [:failed e])))
      (if (= (first outcome) :ok)
        outcome
        (let (mapped (changeset/constraint-error cs (second outcome)))
          (if (nil? mapped)
            (throw (second outcome))
            [:error (changeset/with-action mapped action)]))))))

(defn- source-of (cs opts)
  (or (get opts :table)
    (changeset/source cs)
    (error "repo: the changeset names no table — cast it with a schema or pass :table")))

(defn insert-changeset (repo cs &optional (opts {}))
  "Insert a changeset's data with its changes applied. `[:ok row]`, or `[:error cs]`
  when it is invalid or a declared constraint (`changeset/unique-constraint` …) fails."
  (persist cs
    :insert (fn ()
      (let (row (insert repo (source-of cs opts) (changeset/apply-changes cs) opts))
        (if (nil? row) (changeset/apply-changes cs) row)))))

(defn update-changeset (repo cs &optional (opts {}))
  "Update the row a changeset was made from (found by its primary key) with its
  changes. `[:ok row]` or `[:error cs]`; with no changes it is `[:ok data]` and no
  statement."
  (if (and (changeset/valid? cs) (empty? (changeset/changes cs)))
    [:ok (changeset/data cs)]
    (persist cs
      :update (fn ()
        (let (pk (changeset/primary-key cs)
              key-value (get (changeset/data cs) pk)
              _ (when (nil? key-value)
                  (error "repo: update-changeset: the data has no " (pr-str pk) " to update by"))
              rows (update repo
                     (source-of cs opts)
                     (changeset/changes cs)
                     [:= pk key-value]
                     opts))
          (if (empty? rows)
            (changeset/apply-changes cs)
            (merge (changeset/data cs) (first rows))))))))

;; ---- DDL conveniences ----------------------------------------------------------
;; A real schema change is a migration (see `migration`); these are for a test's
;; throwaway tables.

(defn create-table (repo schema-map &optional (opts {}))
  "Create the table described by `schema-map` (see the `schema` module)."
  (exec repo (schema/create-table-sql schema-map opts) []))

(defn drop-table (repo schema-map &optional (opts {:if-exists true}))
  "Drop the table described by `schema-map` (IF EXISTS unless `opts` say otherwise)."
  (exec repo (schema/drop-table-sql schema-map opts) []))

(defn columns (repo table)
  "The live column names (keywords) of `table`, via the adaptor's introspection.
  Empty when the table doesn't exist."
  (map ((get (get repo :adaptor) :columns) (get repo :pool)
         (->string (if (map? table) (get table :table) table)))
    (fn (c) (keyword (get c :name)))))

;; ---- associations / preloads ------------------------------------------------
;; A schema's :associations describes related tables, e.g.
;;   :associations
;;     {:posts  {:type :has-many   :table :posts :fk :author_id :schema (fn () post)}
;;      :author {:type :belongs-to :table :users :fk :author_id :references :id}
;;      :tags   {:type :many-to-many :table :tags :join-table :post_tags
;;               :join-keys [:post_id :tag_id] :references :id :schema (fn () tag)}}
;; preload runs ONE query per association level (no N+1; many-to-many is two — the
;; join table then the targets). `:schema` (the related schema, or a thunk for
;; mutually-recursive schemas) is only needed for NESTED preloads.

(defn preload (repo schema rows spec)
  "Eager-load associations onto `rows`. `spec` is a keyword (one association), a
  vector of specs `[:posts :author]`, or a map `{assoc → nested-spec}` for nested
  preloads, e.g. `{:posts :comments}` or `{:posts [:comments :author]}`."
  (cond
    (keyword? spec) (preload-one repo schema rows spec nil)
    (map? spec) (reduce (keys spec) rows (fn (rs k) (preload-one repo schema rs k (get spec k))))
    (vector? spec) (reduce spec rows (fn (rs s) (preload repo schema rs s)))
    else (throw (str "preload: bad spec " (pr-str spec)))))

(defn- preload-one (repo schema rows akey nested)
  (let (rel (get (get schema :associations) akey))
    (if (nil? rel)
      (throw (str "preload: schema has no association " (pr-str akey)))
      (let (loaded (preload-attach repo schema rows akey rel))
        (if (nil? nested) loaded (preload-nest repo loaded akey rel nested))))))

(defn- preload-attach (repo schema rows akey rel)
  "Run one association's query and attach it under `akey` (no nesting)."
  (cond
    (= (get rel :type) :has-many)
      (preload-children repo rows akey rel (get schema :primary-key) false)
    (= (get rel :type) :has-one)
      (preload-children repo rows akey rel (get schema :primary-key) true)
    (= (get rel :type) :belongs-to) (preload-belongs-to repo rows akey rel)
    (= (get rel :type) :many-to-many)
      (preload-many-to-many repo rows akey rel (get schema :primary-key))
    else (throw (str "preload: unknown association type " (pr-str (get rel :type))))))

;; has-many / has-one: child.fk references the parent's key. `one?` attaches the
;; first child instead of the list.
(defn- preload-children (repo rows akey rel parent-key one?)
  (let (ref (or (get rel :references) parent-key)
        fk (get rel :fk)
        ids (seq/distinct (seq/filter (map rows (fn (r) (get r ref))) (fn (x) (not (nil? x)))))
        kids (if (empty? ids)
               []
               (all repo (-> (query/from (get rel :table)) (query/where [:in fk ids]))))
        grouped (seq/group-by kids (fn (c) (get c fk))))
    (map rows
      (fn (r)
        (let (g (or (get grouped (get r ref)) []))
          (assoc r akey (if one? (first g) g)))))))

;; belongs-to: this row's fk references the target's key; attach the single match.
(defn- preload-belongs-to (repo rows akey rel)
  (let (fk (get rel :fk)
        ref (or (get rel :references) :id)
        ids (seq/distinct (seq/filter (map rows (fn (r) (get r fk))) (fn (x) (not (nil? x)))))
        parents (if (empty? ids)
                  []
                  (all repo (-> (query/from (get rel :table)) (query/where [:in ref ids]))))
        index (reduce parents {} (fn (m p) (assoc m (get p ref) p))))
    (map rows (fn (r) (assoc r akey (get index (get r fk)))))))

;; many-to-many: parent → join-table → target. Two queries: the join rows for the
;; parents' keys, then the targets for the join's target keys.
(defn- preload-many-to-many (repo rows akey rel parent-key)
  (let (jk (get rel :join-keys)
        pfk (first jk)
        tfk (second jk)
        tref (or (get rel :references) :id)
        pkeys (seq/distinct (seq/filter (map rows (fn (r) (get r parent-key)))
                              (fn (x) (not (nil? x)))))
        joins (if (empty? pkeys)
                []
                (all repo (-> (query/from (get rel :join-table)) (query/where [:in pfk pkeys]))))
        tids (seq/distinct (seq/filter (map joins (fn (j) (get j tfk))) (fn (x) (not (nil? x)))))
        targets (if (empty? tids)
                  []
                  (all repo (-> (query/from (get rel :table)) (query/where [:in tref tids]))))
        tindex (reduce targets {} (fn (m t) (assoc m (get t tref) t)))
        joins-by-parent (seq/group-by joins (fn (j) (get j pfk))))
    (map rows
      (fn (r)
        (let (js (or (get joins-by-parent (get r parent-key)) []))
          (assoc r akey (map js (fn (j) (get tindex (get j tfk))))))))))

;; Nested preload: recurse `nested` onto the just-loaded associated rows, using the
;; association's `:schema`, then re-attach by primary key (collect → preload → index
;; → redistribute, so it stays one query per level).
(defn- preload-nest (repo loaded akey rel nested)
  (let (child-schema (resolve-schema (get rel :schema) akey)
        child-pk (get child-schema :primary-key)
        many? (not (= (get rel :type) :belongs-to))
        kids (if many?
               (reduce loaded [] (fn (acc r) (into acc (get r akey))))
               (seq/filter (map loaded (fn (r) (get r akey))) (fn (x) (not (nil? x)))))
        done (preload repo child-schema kids nested)
        idx (reduce done {} (fn (m c) (assoc m (get c child-pk) c))))
    (map loaded
      (fn (r)
        (assoc r
          akey
            (if many?
              (map (get r akey) (fn (c) (get idx (get c child-pk))))
              (let (c (get r akey)) (if (nil? c) nil (get idx (get c child-pk))))))))))

(defn resolve-schema (s akey)
  (cond
    (nil? s)
      (throw (str "preload: association " (pr-str akey) " needs a :schema for a nested preload"))
    (fn? s) (s)
    else s))

;; ---- connections and transactions ---------------------------------------------

(defn bound? (repo)
  "True when `repo` is bound to one connection (inside `with-connection`/`transaction`)."
  (not (nil? (get repo :run))))

(defn with-connection (repo f)
  "Run `(f conn)` with `conn` a repo bound to ONE checked-out connection, returned to the
  pool afterwards — for work that must share a session (an advisory lock, a temporary
  table). Already bound, `f` gets `repo` itself."
  (if (bound? repo)
    (f repo)
    (let (adaptor (get repo :adaptor)
          checkout (get adaptor :with-connection))
      (when (nil? checkout) (error "repo: this adaptor has no :with-connection"))
      (checkout (get repo :pool) (fn (run) (f (assoc repo :run run :depth 0)))))))

(defn- finish (conn statement)
  "Run a ROLLBACK-type `statement`, swallowing its own failure: the original error is the
  one worth raising, and a dead connection cannot roll back anyway (the server does)."
  (check-allow :discarded-catch (try (exec conn statement []) (catch _ nil))))

(defn transaction (repo f)
  "Run `(f tx)` inside a database transaction. `tx` is a repo bound to the transaction's
  connection — use the same `all`/`one`/`insert`/`update`/`delete`/`exec` on it. Commits
  if `f` returns; rolls back and re-raises if it throws. Returns `f`'s value.

  Nested — `transaction` on a `tx` — is a SAVEPOINT: an inner failure rolls back only the
  inner work, and the outer transaction carries on if the caller catches it."
  (with-connection repo
    (fn (conn)
      (let (depth (get conn :depth 0)
            inner (assoc conn :depth (inc depth))
            savepoint (str "store_savepoint_" depth))
        (exec conn (if (= depth 0) "BEGIN" (str "SAVEPOINT " savepoint)) [])
        (let (outcome (try [:ok (f inner)] (catch e [:failed e])))
          (if (= (first outcome) :ok)
            (do
              (exec conn (if (= depth 0) "COMMIT" (str "RELEASE SAVEPOINT " savepoint)) [])
              (second outcome))
            (do
              (finish conn (if (= depth 0) "ROLLBACK" (str "ROLLBACK TO SAVEPOINT " savepoint)))
              (throw (second outcome)))))))))

;; ---- advisory locks -------------------------------------------------------------
;; A lock named by an integer `key`, held by the database rather than by any row — what
;; keeps two machines from running the same migrations at once. An adaptor without
;; `:lock-sql` takes no lock (a single-process database needs none).

(defn- lock-sql (repo kind)
  (get (get (get repo :adaptor) :lock-sql) kind))

(defn with-lock (repo key f)
  "Run `(f conn)` holding the session advisory lock `key`, waiting for it if another
  session holds it. Released afterwards, however `f` ends (and by the database, if the
  connection dies)."
  (with-connection repo
    (fn (conn)
      (let (acquire (lock-sql conn :acquire))
        (if (nil? acquire)
          (f conn)
          (do
            (exec conn acquire [key])
            (let (outcome (try [:ok (f conn)] (catch e [:failed e])))
              (finish conn (lock-sql conn :release))
              (if (= (first outcome) :ok) (second outcome) (throw (second outcome))))))))))

(defn transaction-lock (tx key)
  "Take the advisory lock `key` until `tx`'s transaction ends — serialising writers to
  one resource (a project's pointer log) without locking a row."
  (when (nil? (get tx :run)) (error "repo: transaction-lock needs a transaction's repo"))
  (let (sql (lock-sql tx :transaction))
    (when sql (exec tx sql [key]))
    nil))

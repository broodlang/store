(defmodule repo
  "The repo — the boundary between your code and the database.

  Open it with an *adaptor* (a contract map, e.g. from `store-postgres`'s `pg/adaptor`)
  and connection opts; run data queries through it. The adaptor performs the SQL I/O,
  so this library stays database-agnostic. `all`/`one` take a query map (see `query`)
  and return rows as plain maps keyed by column name."
  (:alias query)
  (:alias schema))

(defn open (adaptor opts)
  "Open a repo over `adaptor` and connection `opts` (starts the adaptor's pool).
  Returns a repo handle; close it with `close`."
  {:adaptor adaptor :pool ((get adaptor :start-pool) opts)})

(defn close (repo)
  "Stop the repo's connection pool."
  ((get (get repo :adaptor) :stop-pool) (get repo :pool)))

;; ---- running queries --------------------------------------------------------

(defn exec (repo sql params)
  "Run raw parameterized SQL (`$1`, `$2`, …) — the escape hatch. Returns the rows
  as maps keyed by column name (keywords); the adaptor handles the DB specifics."
  ((get (get repo :adaptor) :exec) (get repo :pool) sql params))

(defn all (repo q)
  "Run query `q` and return its rows as maps keyed by column name (keywords)."
  (let (sp (query/to-sql q))
    (exec repo (get sp 0) (get sp 1))))

(defn one (repo q)
  "Run `q` with LIMIT 1; return the first row map, or nil if none."
  (first (all repo (query/limit q 1))))

;; ---- writes -----------------------------------------------------------------

(defn insert (repo table row)
  "Insert one `{:col value …}` row into `table`; return the inserted row map."
  (let (sp (query/insert-sql table row))
    (first (exec repo (get sp 0) (get sp 1)))))

(defn update (repo table changes where-expr)
  "Set `changes` on rows of `table` matching `where-expr`; return the updated rows."
  (let (sp (query/update-sql table changes where-expr))
    (exec repo (get sp 0) (get sp 1))))

(defn delete (repo table where-expr)
  "Delete rows of `table` matching `where-expr`; return the deleted rows."
  (let (sp (query/delete-sql table where-expr))
    (exec repo (get sp 0) (get sp 1))))

;; ---- migrations (derived from a schema) -------------------------------------

(defn create-table (repo schema-map)
  "Create the table described by `schema-map` (see the `schema` module)."
  (exec repo (schema/create-table-sql schema-map) []))

(defn drop-table (repo schema-map)
  "Drop the table described by `schema-map` (IF EXISTS)."
  (exec repo (schema/drop-table-sql schema-map) []))

;; ---- associations / preloads ------------------------------------------------
;; A schema's :associations describes related tables, e.g.
;;   :associations {:posts  {:type :has-many   :table :posts :fk :author_id}
;;                  :author {:type :belongs-to :table :users :fk :author_id :references :id}}
;; preload eager-loads them with ONE query per association (no N+1): it gathers the
;; keys across all rows, fetches the related rows in a single `… WHERE k IN (…)`,
;; and attaches them — a list for :has-many, a single row (or nil) for :has-one /
;; :belongs-to.

(defn preload (repo schema rows assocs)
  "Load association(s) onto `rows` (a list of row-maps) using `schema`'s
  :associations. `assocs` is one key or a vector of keys."
  (reduce (fn (rs a) (preload--one repo schema rs a))
    rows
    (if (keyword? assocs) [assocs] assocs)))

(defn preload--one (repo schema rows akey)
  (let (rel (get (get schema :associations) akey))
    (cond
      (nil? rel) (throw (str "preload: schema has no association " (pr-str akey)))
      (= (get rel :type) :has-many) (preload--has-many repo rows akey rel (get schema :primary-key))
      (= (get rel :type) :has-one) (preload--has-one repo rows akey rel (get schema :primary-key))
      (= (get rel :type) :belongs-to) (preload--belongs-to repo rows akey rel)
      else (throw (str "preload: unknown association type " (pr-str (get rel :type)))))))

;; has-many / has-one: child.fk references the parent's key; fetch children whose fk
;; is in the parents' keys, grouped by fk.
(defn preload--children (repo rows rel parent-key)
  (let (ref (or (get rel :references) parent-key)
        fk (get rel :fk)
        ids (distinct (filter (fn (x) (not (nil? x))) (map (fn (r) (get r ref)) rows)))
        kids (if (empty? ids)
               []
               (all repo (-> (query/from (get rel :table)) (query/where [:in fk ids])))))
    [ref (group-by (fn (c) (get c fk)) kids)]))

(defn preload--has-many (repo rows akey rel parent-key)
  (let (g (preload--children repo rows rel parent-key)
        ref (get g 0) grouped (get g 1))
    (map (fn (r) (assoc r akey (or (get grouped (get r ref)) []))) rows)))

(defn preload--has-one (repo rows akey rel parent-key)
  (let (g (preload--children repo rows rel parent-key)
        ref (get g 0) grouped (get g 1))
    (map (fn (r) (assoc r akey (first (get grouped (get r ref))))) rows)))

;; belongs-to: this row's fk references the parent table's key; fetch those parents
;; and attach the single match.
(defn preload--belongs-to (repo rows akey rel)
  (let (fk (get rel :fk)
        ref (or (get rel :references) :id)
        ids (distinct (filter (fn (x) (not (nil? x))) (map (fn (r) (get r fk)) rows)))
        parents (if (empty? ids)
                  []
                  (all repo (-> (query/from (get rel :table)) (query/where [:in ref ids]))))
        index (reduce (fn (m p) (assoc m (get p ref) p)) {} parents))
    (map (fn (r) (assoc r akey (get index (get r fk)))) rows)))

;; ---- transactions -----------------------------------------------------------

(defn transaction (repo f)
  "Run `(f tx)` inside a database transaction. `tx` is a repo bound to the
  transaction's single connection — use the same `all`/`one`/`insert`/`update`/
  `delete`/`exec` on it. Commits if `f` returns; rolls back and re-raises if `f`
  throws. Returns `f`'s value. (Adaptor-dependent: store-postgres is fully
  transactional; an adaptor that can't support it raises.)"
  ((get (get repo :adaptor) :transaction)
   (get repo :pool)
   (fn (tx-exec)
     (f {:adaptor {:exec (fn (_ sql params) (tx-exec sql params))}
         :pool nil}))))
